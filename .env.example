NODE_ENV=production
PORT=3090
TZ=America/Sao_Paulo

# Banco exclusivo do modulo. Em producao use credenciais proprias.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=api_pagamento
DB_USER=payment_app
DB_PASSWORD=CHANGE_ME_PAYMENT_DB_PASSWORD
DB_POOL_SIZE=20

# Autenticacao entre modulos internos -> api_pagamento.
PAYMENT_API_KEY=CHANGE_ME_PAYMENT_API_KEY

# Provedor padrao por metodo. Valores suportados: cash, mock, tef, getnet, rede, pagbank.
PAYMENT_PROVIDER_CASH=cash
PAYMENT_PROVIDER_PIX=mock
PAYMENT_PROVIDER_DEBIT=mock
PAYMENT_PROVIDER_CREDIT=mock

# TEF presencial. O agente roda ao lado do PIN pad e nunca envia PAN/CVV/PIN ao gateway.
PAYMENT_TEF_AGENT_URL=http://tef-agent:8766
PAYMENT_TEF_AGENT_TOKEN=CHANGE_ME_TEF_AGENT_TOKEN
PAYMENT_TEF_WEBHOOK_SECRET=CHANGE_ME_TEF_WEBHOOK_SECRET
PAYMENT_TEF_DEFAULT_TERMINAL_ID=TEF-DOCKER-01
PAYMENT_TEF_TIMEOUT_MS=10000

# Fila duravel. Cloud/PIX podem processar em paralelo; jobs com o mesmo
# terminal_id/pinpad_id sao serializados por resource lock no MySQL. O agente
# TEF tambem mantem exclusividade enquanto a sessao aguarda cartao/confirmacao.
PAYMENT_JOB_POLL_MS=250
PAYMENT_JOB_CONCURRENCY=8
PAYMENT_JOB_MAX_ATTEMPTS=12
PAYMENT_JOB_STALE_SECONDS=120
PAYMENT_JOB_MAX_BACKOFF_SECONDS=300

# Homologacao local.
PAYMENT_MOCK_AUTO_APPROVE=true
PAYMENT_MOCK_WEBHOOK_SECRET=CHANGE_ME_MOCK_WEBHOOK_SECRET

# Bridges/adaptadores de adquirentes. O nucleo nunca recebe PAN/CVV.
# Cada bridge deve expor o contrato normalizado documentado em docs/ACQUIRER_ADAPTER.md.
PAYMENT_GETNET_BRIDGE_URL=
PAYMENT_GETNET_BRIDGE_TOKEN=
PAYMENT_GETNET_WEBHOOK_SECRET=
PAYMENT_REDE_BRIDGE_URL=
PAYMENT_REDE_BRIDGE_TOKEN=
PAYMENT_REDE_WEBHOOK_SECRET=
PAYMENT_PAGBANK_BRIDGE_URL=
PAYMENT_PAGBANK_BRIDGE_TOKEN=
PAYMENT_PAGBANK_WEBHOOK_SECRET=

# Eventos para o backoffice. Se vazio, ficam persistidos no outbox e podem ser consultados via API.
BACKOFFICE_WEBHOOK_URL=
BACKOFFICE_WEBHOOK_SECRET=
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=20
HTTP_TIMEOUT_MS=15000
